{
    "hosting":  {
                    "public":  ".",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "cleanUrls":  true,
                    "rewrites":  [
                                     {
                                         "destination":  "/admin/index.html",
                                         "source":  "/admin"
                                     },
                                     {
                                         "destination":  "/admin/index.html",
                                         "source":  "/admin/**"
                                     }
                                 ],
                    "headers":  [
                                    {
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-store, no-cache, must-revalidate, max-age=0"
                                                        }
                                                    ],
                                        "source":  "/"
                                    },
                                    {
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-store, no-cache, must-revalidate, max-age=0"
                                                        }
                                                    ],
                                        "source":  "/index.html"
                                    },
                                    {
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-store, no-cache, must-revalidate, max-age=0"
                                                        }
                                                    ],
                                        "source":  "/admin"
                                    },
                                    {
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-store, no-cache, must-revalidate, max-age=0"
                                                        }
                                                    ],
                                        "source":  "/admin/**"
                                    }
                                ]
                }
}
